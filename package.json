{
  "name": "@solidnumber/cli",
  "version": "2.4.1",
  "description": "AI business infrastructure from the terminal — CRM, payments, voice AI, 116 agents, 52 industry templates. solid clone plumber → instant business. Also: programmatic TS SDK via @solidnumber/cli/sdk.",
  "main": "dist/index.js",
  "type": "commonjs",
  "bin": {
    "solid": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/lib/api-client.d.ts",
      "default": "./dist/lib/api-client.js"
    },
    "./config": {
      "types": "./dist/lib/config.d.ts",
      "default": "./dist/lib/config.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "postbuild": "ts-node scripts/generate-llms.ts",
    "verify:llms": "ts-node scripts/generate-llms.ts --check",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "test:smoke": "jest --testPathPattern=integration --forceExit",
    "test:security": "jest --testPathPattern=company-isolation --forceExit",
    "verify:schemas": "ts-node scripts/verify-schemas.ts",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "prepublish:check": "bash scripts/prepublish.sh",
    "test:tarball": "bash scripts/test-tarball.sh",
    "verify:deps": "node scripts/verify-runtime-deps.mjs",
    "prepublishOnly": "npm run build && npm test && npm run test:security && npm run audit:prod && npm run verify:deps"
  },
  "keywords": [
    "cli",
    "ai",
    "crm",
    "business",
    "saas",
    "mcp",
    "ai-agents",
    "voice-ai",
    "multi-tenant",
    "payments",
    "small-business",
    "agency",
    "white-label",
    "plumber",
    "hvac",
    "dentist",
    "booking",
    "scheduling",
    "seo",
    "ai-receptionist",
    "business-infrastructure"
  ],
  "author": "Solid# <hello@solidnumber.com>",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adam-Camp-King/solid-cli.git"
  },
  "homepage": "https://solidnumber.com/developers",
  "bugs": {
    "url": "https://github.com/Adam-Camp-King/solid-cli/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "platform-docs"
  ],
  "dependencies": {
    "@puppeteer/browsers": "^2.13.0",
    "axios": "^1.6.0",
    "boxen": "^8.0.1",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^12.0.0",
    "figures": "^6.1.0",
    "form-data": "^4.0.5",
    "gradient-string": "^3.0.0",
    "inquirer": "^9.2.0",
    "jsonld": "^9.0.0",
    "lighthouse": "^13.1.0",
    "ora": "^8.0.0",
    "puppeteer-core": "^24.42.0",
    "update-notifier": "^7.3.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.39.0"
  },
  "overrides": {
    "minimatch": "^9.0.7"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/update-notifier": "^6.0.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "acorn": "^8.16.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
