{
  "name": "@solidnumber/cli",
  "version": "1.9.20",
  "description": "AI business infrastructure from the terminal — CRM, payments, voice AI, 116 agents, 52 industry templates. solid clone plumber → instant business.",
  "main": "dist/index.js",
  "bin": {
    "solid": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "test:smoke": "jest --testPathPattern=integration --forceExit",
    "test:security": "jest --testPathPattern=company-isolation --forceExit",
    "audit": "npm audit --audit-level=high",
    "prepublish:check": "bash scripts/prepublish.sh",
    "prepublishOnly": "npm run build && npm test && npm run test:security"
  },
  "keywords": [
    "cli",
    "ai",
    "crm",
    "business",
    "saas",
    "mcp",
    "ai-agents",
    "voice-ai",
    "multi-tenant",
    "payments",
    "small-business",
    "agency",
    "white-label",
    "plumber",
    "hvac",
    "dentist",
    "booking",
    "scheduling",
    "seo",
    "ai-receptionist",
    "business-infrastructure"
  ],
  "author": "Solid# <hello@solidnumber.com>",
  "license": "BSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adam-Camp-King/solid-cli.git"
  },
  "homepage": "https://solidnumber.com/developers",
  "bugs": {
    "url": "https://github.com/Adam-Camp-King/solid-cli/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "platform-docs"
  ],
  "dependencies": {
    "axios": "^1.6.0",
    "boxen": "^8.0.1",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "figures": "^6.1.0",
    "gradient-string": "^3.0.0",
    "inquirer": "^9.2.0",
    "ora": "^8.0.0",
    "update-notifier": "^7.3.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.39.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/update-notifier": "^6.0.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
